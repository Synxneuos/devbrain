{
  "name": "jev-brain",
  "version": "1.0.0",
  "description": "Don't think. Route. Ultra-fast local decision firewall (<20ms) for agents, streams, and LLMs.",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./warden": "./src/core/warden.js",
    "./router": "./src/core/router.js",
    "./cache": "./src/core/semantic-cache.js",
    "./middleware": "./src/sdk/middleware.js"
  },
  "files": [
    "src",
    "bin",
    "types",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "jevbrain": "./bin/brain.js",
    "jev-brain": "./bin/brain.js",
    "brain": "./bin/brain.js"
  },
  "type": "module",
  "scripts": {
    "start": "node bin/brain.js serve",
    "dev": "node bin/brain.js serve --port 3333",
    "test": "node test/router.test.js && node test/mobile.test.js && node test/wallet.test.js && node test/sdk.test.js && node test/discord.test.js && node test/benchmark.test.js && node test/rewards.test.js && node test/security-isolation.test.js && node test/dynamic-burn.test.js && node test/api-keys.test.js",
    "test:devnet": "node test/devnet-financial-integration.mjs",
    "test:e2e": "node test/e2e-production-readiness.mjs",
    "test:full": "npm test && npm run test:e2e && npm run test:devnet",
    "classify": "node bin/brain.js classify",
    "warden": "node bin/brain.js warden",
    "audit": "node bin/brain.js audit"
  },
  "keywords": [
    "ai",
    "agent-firewall",
    "agent-warden",
    "pre-execution-safety",
    "router",
    "llm-guardrails",
    "semantic-cache",
    "openai",
    "github-action",
    "jev-brain"
  ],
  "author": "Synxneuos",
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "discord.js": "^14.27.0",
    "ethers": "^6.17.0"
  }
}
