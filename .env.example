# ================================================================
# ⚡ Jev Brain - Environment Configuration (Netlify & Server)
# ================================================================
# Keep this file safe! In Netlify, add these under:
# Site Settings -> Environment Variables.
# Users on the frontend NEVER see your OpenRouter API Key.

PORT=3333

# ----------------------------------------------------------------
# OpenRouter API Key (Server-Side Internal Gateway)
# Routes to 500+ models (Claude 3.5 Sonnet, GPT-4o, DeepSeek, Llama 3)
# Get key: https://openrouter.ai/keys
# ----------------------------------------------------------------
OPENROUTER_API_KEY=

# Optional: Site URL & Title for OpenRouter Rankings
SITE_URL=https://jevbrain.com
SITE_NAME=Jev Brain

# ----------------------------------------------------------------
# DexScreener Live Token Integration (Solana / Robinhood / EVM)
# ----------------------------------------------------------------
# Token Contract Address (Solana mint address or CA - Paste here once launched)
TOKEN_CONTRACT_ADDRESS=

# Network / Chain: solana | ethereum | base | arbitrum
TOKEN_CHAIN=solana

# ----------------------------------------------------------------
# Standalone Provider Keys (Optional Direct Fallback)
# ----------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
