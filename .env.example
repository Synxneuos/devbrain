# ================================================================
# ⚡ Jev Brain - Environment Configuration
# ================================================================

PORT=3333

# ----------------------------------------------------------------
# OpenRouter API Key (Server-Side Internal Gateway)
# Routes to 500+ models (Claude 3.5 Sonnet, GPT-4o, DeepSeek, Llama 3)
# Get key: https://openrouter.ai/keys
# ----------------------------------------------------------------
OPENROUTER_API_KEY=

# Optional: Site URL & Title for OpenRouter Rankings
SITE_URL=https://jevbrain.com
SITE_NAME=Jev Brain

# ----------------------------------------------------------------
# 🌈 Rainbow Wallet & Token Gating Configuration
# ----------------------------------------------------------------
# Token Contract Address (EVM CA or Solana mint address)
# Replace with your actual deployed token contract
TOKEN_CONTRACT_ADDRESS=0xYourTokenContractAddressHere

# Network / Chain: ethereum | polygon | base | arbitrum | solana
TOKEN_CHAIN=ethereum

# Minimum tokens required to access the platform
# Users holding less than this amount cannot access AI features
MINIMUM_TOKENS_REQUIRED=1000000

# ----------------------------------------------------------------
# DexScreener Live Token Integration
# ----------------------------------------------------------------
# Auto-fetches live market cap and price data
# No API key needed - uses public DexScreener API
DEXSCREENER_API_URL=https://api.dexscreener.com/latest/dex/tokens/

# ----------------------------------------------------------------
# Standalone Provider Keys (Optional Direct Fallback)
# ----------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# ----------------------------------------------------------------
# Web3 Wallet Settings
# ----------------------------------------------------------------
# Supported wallets: rainbow | metamask | walletconnect | phantom
SUPPORTED_WALLETS=rainbow,metamask

# Enable/disable wallet gating (true/false)
WALLET_GATING_ENABLED=true

# Enable/disable token balance checking (true/false)
TOKEN_CHECK_ENABLED=true

